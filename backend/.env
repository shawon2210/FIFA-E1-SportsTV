# A1TV v2 — Environment Configuration
# Copy to .env and customize for your deployment
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PORT=3000
NGINX_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5500

# ── Database ──────────────────────────────────────────────
DB_HOST=172.20.144.1
DB_PORT=5432
DB_NAME=a1tv
DB_USER=a1tv
DB_PASSWORD=a1tv_secret
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_STRING

# ── S3 / R2 (for backups and logos) ───────────────────────
# S3_BUCKET=a1tv-assets
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# ── Alert Channels (optional) ─────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=-1001234567890
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Backup ────────────────────────────────────────────────
# BACKUP_DIR=/tmp/a1tv-backups
# BACKUP_RETENTION_DAYS=30

# ── Sync ──────────────────────────────────────────────────
SYNC_INTERVAL_HOURS=6

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
