# A1TV Backend — Environment Configuration
# Copy to .env and customize

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5500,http://localhost:3001,http://localhost:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=a1tv
DB_USER=a1tv
DB_PASSWORD=a1tv_secret
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Sync
SYNC_INTERVAL_HOURS=6
