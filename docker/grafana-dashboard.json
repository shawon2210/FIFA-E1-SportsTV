{
  "dashboard": {
    "title": "A1TV v2 — System Overview",
    "uid": "a1tv-v2",
    "panels": [
      {
        "title": "Active Streams by Status",
        "type": "piechart",
        "targets": [{ "expr": "a1tv_active_streams", "legendFormat": "{{status}}" }],
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
      },
      {
        "title": "Total Channels",
        "type": "stat",
        "targets": [{ "expr": "sum(a1tv_total_channels)" }],
        "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 }
      },
      {
        "title": "WebSocket Clients",
        "type": "stat",
        "targets": [{ "expr": "a1tv_websocket_clients" }],
        "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 }
      },
      {
        "title": "HTTP Request Duration (p95)",
        "type": "graph",
        "targets": [{ "expr": "histogram_quantile(0.95, rate(a1tv_http_request_duration_seconds_bucket[5m]))" }],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "title": "Stream Health Over Time",
        "type": "graph",
        "targets": [
          { "expr": "a1tv_active_streams{status='online'}", "legendFormat": "Online" },
          { "expr": "a1tv_active_streams{status='offline'}", "legendFormat": "Offline" },
          { "expr": "a1tv_active_streams{status='geo_blocked'}", "legendFormat": "Geo-blocked" },
          { "expr": "a1tv_active_streams{status='slow'}", "legendFormat": "Slow" }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
      },
      {
        "title": "Node.js Process",
        "type": "graph",
        "targets": [
          { "expr": "process_resident_memory_bytes{job='a1tv-api'}", "legendFormat": "Memory" },
          { "expr": "rate(process_cpu_seconds_total{job='a1tv-api'}[5m])", "legendFormat": "CPU" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
      },
      {
        "title": "HTTP Requests by Status",
        "type": "graph",
        "targets": [
          { "expr": "rate(a1tv_http_request_duration_seconds_count{status_code=~'2..'}[5m])", "legendFormat": "2xx" },
          { "expr": "rate(a1tv_http_request_duration_seconds_count{status_code=~'4..'}[5m])", "legendFormat": "4xx" },
          { "expr": "rate(a1tv_http_request_duration_seconds_count{status_code=~'5..'}[5m])", "legendFormat": "5xx" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
      }
    ],
    "time": { "from": "now-6h", "to": "now" },
    "refresh": "30s"
  }
}
